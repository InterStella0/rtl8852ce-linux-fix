#!/bin/bash
# wifi-bt-status - is the fix working? Reads sysfs and the journal only.
#
#   wifi-bt-status            since the fix was installed
#   wifi-bt-status 24h        last 24 hours   (any "journalctl --since" value:
#   wifi-bt-status today       "2 days ago", "2026-11-11", ...)
set -u

state=/var/lib/bcn-guard
since=${1:-}
case "$since" in
"") [ -r "$state/installed-at" ] && since=$(cat "$state/installed-at") || since="24 hours ago" ;;
*h) since="${since%h} hours ago" ;;
*d) since="${since%d} days ago" ;;
esac

bold=$(tput bold 2> /dev/null || true); rst=$(tput sgr0 2> /dev/null || true)
h() { echo; echo "${bold}$*${rst}"; }

h "Beacon guard"
if [ -r /sys/module/bcn_guard/parameters/stats ]; then
	echo "  module: loaded"
	sed 's/^/  /' /sys/module/bcn_guard/parameters/stats
else
	echo "  module: NOT LOADED  (Wi-Fi is running stock; disconnects are not being prevented)"
	[ -e "$state/tripped" ] && echo "  TRIPPED by the crash-loop breaker. Re-arm: sudo rm $state/tripped && sudo systemctl restart bcn-guard"
	modinfo bcn_guard > /dev/null 2>&1 || echo "  no module built for kernel $(uname -r): are the kernel headers installed?  (dkms status)"
	systemctl is-enabled bcn-guard 2> /dev/null | sed 's/^/  service: /'
fi

h "Wi-Fi link"
iface=$(iw dev 2> /dev/null | awk '$1 == "Interface" {print $2; exit}')
if [ -n "$iface" ]; then
	iw dev "$iface" link 2> /dev/null | grep -E 'Connected|freq|signal|rx bitrate' | sed 's/^\s*/  /'
	uuid=$(nmcli -t -f UUID,TYPE connection show --active 2> /dev/null | awk -F: '$2 == "802-11-wireless" {print $1; exit}')
	if [ -n "$uuid" ]; then
		band=$(nmcli -g 802-11-wireless.band connection show "$uuid" 2> /dev/null)
		echo "  band pin: ${band:-none}"
	fi
fi

h "Events since: $since"
log=$(journalctl --no-pager -o cat --since "$since" 2> /dev/null)
n() { printf '%s\n' "$log" | grep -cE "$1"; }
row() { printf '  %6s  %s\n' "$1" "$2"; }
row "$(n 'appears to change mode \(expected')"                  "Wi-Fi: kernel disconnected because of a bad beacon   (want 0)"
row "$(n 'bcn_guard: .*: dropped beacon')"             "Wi-Fi: bad beacons hidden by the guard (log lines are rate-limited)"
row "$(n 'bcn_guard: .*letting them through')"         "Wi-Fi: guard gave up on a persistent change"
row "$(n 'Trying to authenticate with .*freq=24')"     "Wi-Fi: joined the 2.4 GHz radio                      (want 0)"
row "$(n 'WNM: Disassociation Imminent')"              "Wi-Fi: router band-steering requests"
row "$(n 'wlan[0-9]*: (deauthenticated|disassociated) from')" "Wi-Fi: kicked by the router"
row "$(n 'CTRL-EVENT-DISCONNECTED')"                   "Wi-Fi: disconnects (any reason)"
row "$(n 'RXDCK timeout')"                             "Wi-Fi: RX calibration timeouts (antenna shared with Bluetooth)"
row "$(n 'Failure in Bluetooth audio transport')"      "Bluetooth: audio transport failures                  (want 0)"
row "$(printf '%s\n' "$log" | grep 'Missing completion reports' | wc -l)" "Bluetooth: controller stopped acknowledging audio packets"
row "$(n 'Stopping Bluetooth service')"                "Bluetooth: service restarts"
echo
